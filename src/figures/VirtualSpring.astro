---
// Impedance control as a virtual spring and damper.
import ArrowDef from '../components/ArrowDef.astro';
const zig = (x1: number, x2: number, y: number) => { const n = 8, dx = (x2 - x1 - 24) / n; let d = `M${x1} ${y} h12`; for (let i = 0; i < n; i++) d += ` l${dx / 2} ${i % 2 ? 9 : -9} l${dx / 2} ${i % 2 ? -9 : 9}`; return d + ' h12'; };
---
<svg class="fig" viewBox="0 0 700 280" role="img" aria-labelledby="vs-title vs-desc">
  <title id="vs-title">Impedance control as a virtual spring and damper</title>
  <desc id="vs-desc">The controller behaves as if a spring and a damper connected the robot's hand to a target point. In free space the hand follows the target. When a wall blocks it, the hand stops at the wall and pushes with a force equal to the spring stiffness times the remaining distance, instead of pushing ever harder.</desc>
  <defs><ArrowDef id="ah-vs" /></defs>
  <text x="170" y="24" text-anchor="middle" class="t-strong">Free space</text>
  <circle class="surface c3" stroke-width="2.5" stroke-dasharray="4 3" cx="280" cy="80" r="12" /><text x="280" y="52" text-anchor="middle" class="t-small t-c3">target</text>
  <circle class="f1" cx="90" cy="80" r="14" /><text x="90" y="52" text-anchor="middle" class="t-small t-c1">hand</text>
  <path class="c2 thick" d={zig(104, 268, 70)} /><path class="wire" d="M104 92 H170 M170 84 V100 M170 84 H200 M170 100 H200 M186 92 H268 M186 86 V98" />
  <text x="186" y="124" text-anchor="middle" class="t-small"><tspan class="t-c2">spring K</tspan> and damper D</text>
  <text x="170" y="150" text-anchor="middle" class="t-small t-muted">the hand is pulled to the target</text>

  <line class="grid" x1="350" y1="10" x2="350" y2="200" />
  <text x="530" y="24" text-anchor="middle" class="t-strong">Blocked by a wall</text>
  <rect class="box" x="520" y="40" width="22" height="100" /><text x="531" y="156" text-anchor="middle" class="t-small t-muted">wall</text>
  <circle class="surface c3" stroke-width="2.5" stroke-dasharray="4 3" cx="640" cy="80" r="12" /><text x="640" y="52" text-anchor="middle" class="t-small t-c3">target</text>
  <circle class="f1" cx="506" cy="80" r="14" />
  <path class="c2 thick" d="M542 80 h10 l7 -9 l14 18 l14 -18 l14 18 l14 -18 l7 9 h6" />
  <line class="wire thick" x1="440" y1="80" x2="488" y2="80" marker-end="url(#ah-vs)" /><text x="440" y="70" class="t-small t-strong">force</text>
  <line class="wire-muted" x1="506" y1="176" x2="640" y2="176" marker-start="url(#ah-vs)" marker-end="url(#ah-vs)" /><text x="573" y="194" text-anchor="middle" class="t-small t-math">Δx</text>

  <text x="350" y="232" text-anchor="middle" class="t-strong">force = K · Δx + D · (velocity error)</text>
  <text x="350" y="254" text-anchor="middle" class="t-small">Contact force is bounded and chosen in advance by K. A stiff position controller would push as hard as its motors allow.</text>
</svg>
