---
// One Kalman update: prediction and measurement combine into a tighter estimate.
const X = (x: number) => 60 + ((x + 1) / 9) * 600, Y = (p: number) => 230 - p * 260;
const g = (x: number, m: number, s: number) => Math.exp(-0.5 * ((x - m) / s) ** 2) / (s * Math.sqrt(2 * Math.PI));
const xs = Array.from({ length: 181 }, (_, i) => -1 + i * 0.05);
const pm = 2.6, ps = 1.2, zm = 4.8, zs = 0.8;
const K = (ps * ps) / (ps * ps + zs * zs), um = pm + K * (zm - pm), us = Math.sqrt((1 - K) * ps * ps);
const line = (m: number, s: number) => xs.map((x) => `${X(x).toFixed(1)},${Y(g(x, m, s)).toFixed(1)}`).join(' ');
---
<svg class="fig" viewBox="0 0 700 304" role="img" aria-labelledby="ks-title ks-desc">
  <title id="ks-title">One Kalman filter update</title>
  <desc id="ks-desc">Three bell curves over position. The prediction is wide. The measurement is narrower and centred elsewhere. The updated estimate lies between them, closer to the measurement because it is the more certain of the two, and is narrower than either.</desc>
  <line class="axis" x1="60" y1="230" x2="660" y2="230" />
  <polyline class="c1 thick" points={line(pm, ps)} /><polyline class="c3 thick" points={line(zm, zs)} /><polyline class="c2" fill="none" stroke-width="3.2" points={line(um, us)} />
  <line class="c1 dash" stroke-width="1.2" x1={X(pm)} y1="230" x2={X(pm)} y2={Y(g(pm, pm, ps))} /><line class="c3 dash" stroke-width="1.2" x1={X(zm)} y1="230" x2={X(zm)} y2={Y(g(zm, zm, zs))} /><line class="c2 dash" stroke-width="1.2" x1={X(um)} y1="230" x2={X(um)} y2={Y(g(um, um, us))} />
  <text x={X(pm) - 80} y={Y(g(pm, pm, ps)) - 16} text-anchor="middle" class="t-strong t-c1">Prediction</text><text x={X(pm) - 80} y={Y(g(pm, pm, ps)) + 1} text-anchor="middle" class="t-small">from the motion model</text>
  <text x={X(zm) + 100} y={Y(g(zm, zm, zs)) + 6} text-anchor="middle" class="t-strong t-c3">Measurement</text><text x={X(zm) + 100} y={Y(g(zm, zm, zs)) + 23} text-anchor="middle" class="t-small">from the sensor</text>
  <text x={X(um)} y={Y(g(um, um, us)) - 26} text-anchor="middle" class="t-strong t-c2">Updated estimate</text><text x={X(um)} y={Y(g(um, um, us)) - 10} text-anchor="middle" class="t-small">between the two, and narrower than both</text>
  <text x="360" y="254" text-anchor="middle" class="t-muted">Position</text>
  <text x="360" y="278" text-anchor="middle" class="t-small t-muted">The estimate moves toward whichever source is more certain.</text><text x="360" y="294" text-anchor="middle" class="t-small t-muted">Here the measurement has the smaller spread, so it gets most of the weight.</text>
</svg>
