---
// On-axis magnetic absolute encoder.
import ArrowDef from '../components/ArrowDef.astro';
---
<svg class="fig" viewBox="0 0 680 260" role="img" aria-labelledby="me-title me-desc">
  <title id="me-title">An on-axis magnetic encoder</title>
  <desc id="me-desc">Side view: a small disc magnet, magnetised across its diameter, is fixed to the end of the shaft and turns just above a sensor chip on a circuit board. Top view: the chip measures two perpendicular components of the magnet's field, proportional to the sine and cosine of the shaft angle, and computes the angle from their ratio.</desc>
  <defs><ArrowDef id="ah-me" /></defs>
  <text x="150" y="22" text-anchor="middle" class="t-strong">Side view</text>
  <rect class="box" x="130" y="34" width="40" height="92" rx="4" /><text x="100" y="80" text-anchor="end" class="t-small">shaft</text>
  <rect class="f3" x="106" y="126" width="44" height="18" /><rect class="f1" x="150" y="126" width="44" height="18" />
  <text x="128" y="139" text-anchor="middle" class="t-small t-invert">N</text><text x="172" y="139" text-anchor="middle" class="t-small t-invert">S</text>
  <text x="210" y="139" class="t-small">magnet</text>
  <line class="wire-muted dash" x1="150" y1="20" x2="150" y2="210" />
  <rect class="ink-fill" x="128" y="158" width="44" height="12" rx="2" /><text x="210" y="169" class="t-small">sensor chip</text>
  <rect class="soft2 c2" stroke-width="1.4" x="60" y="172" width="180" height="12" rx="2" /><text x="150" y="204" text-anchor="middle" class="t-small t-muted">circuit board (does not rotate)</text>
  <line class="wire-muted" x1="96" y1="146" x2="96" y2="158" /><text x="90" y="156" text-anchor="end" class="t-small t-muted">air gap</text>

  <text x="470" y="22" text-anchor="middle" class="t-strong">Top view</text>
  <circle class="f1" cx="470" cy="130" r="74" />
  <path class="f3" d="M470 130 m-52.3 -52.3 a74 74 0 0 1 104.6 104.6 z" />
  <line class="surface-stroke" x1="417.7" y1="77.7" x2="522.3" y2="182.3" />
  <text x="516" y="156" text-anchor="middle" class="t-strong t-invert">N</text><text x="428" y="150" text-anchor="middle" class="t-strong t-invert">S</text>
  <line class="wire-muted" x1="370" y1="130" x2="580" y2="130" marker-end="url(#ah-me)" /><line class="wire-muted" x1="470" y1="230" x2="470" y2="36" marker-end="url(#ah-me)" />
  <line class="wire thick" x1="470" y1="130" x2="536" y2="64" marker-end="url(#ah-me)" />
  <path class="wire none" d="M510 130 A40 40 0 0 0 498.3 101.7" /><text x="518" y="116" class="t-small t-math">θ</text>
  <text x="584" y="146" class="t-small">cos θ</text><text x="478" y="44" class="t-small">sin θ</text>
  <text x="470" y="250" text-anchor="middle" class="t-strong">θ = atan2(sin, cos)</text>
</svg>
