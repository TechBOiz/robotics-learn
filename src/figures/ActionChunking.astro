---
// Action chunking: predict a sequence, execute part of it, predict again.
const X = (t: number) => 70 + t * 30;
const chunks = [{ s: 0, y: 60 }, { s: 5, y: 104 }, { s: 10, y: 148 }];
---
<svg class="fig" viewBox="0 0 700 250" role="img" aria-labelledby="ac-title ac-desc">
  <title id="ac-title">Action chunking</title>
  <desc id="ac-desc">The policy predicts a chunk of ten future actions at once. The robot executes the first five, then the policy predicts a fresh chunk from the new observation. Successive chunks overlap, and only the first part of each is used.</desc>
  {chunks.map((c, i) => (
    <g>
      {Array.from({ length: 10 }, (_, k) => <rect class={k < 5 ? 'f1' : 'soft1'} x={X(c.s + k)} y={c.y} width="26" height="26" rx="4" />)}
      <text x={X(c.s) - 8} y={c.y + 18} text-anchor="end" class="t-small">chunk {i + 1}</text>
      <line class="wire-muted dash" x1={X(c.s)} y1="40" x2={X(c.s)} y2="196" />
    </g>
  ))}
  <line class="axis" x1="70" y1="196" x2="680" y2="196" /><text x="375" y="216" text-anchor="middle" class="t-muted">Time steps</text>
  <text x={X(2.5)} y="34" text-anchor="middle" class="t-small t-strong t-c1">executed</text><text x={X(7.5)} y="34" text-anchor="middle" class="t-small t-muted">predicted, then replaced</text>
  <text x="375" y="240" text-anchor="middle" class="t-small">One network call yields many control steps. Committing to a short plan also keeps the motion consistent from step to step.</text>
</svg>
