---
// Three-phase inverter: six switches between a DC bus and three motor phases.
const legs = [{ x: 250, n: 'A' }, { x: 350, n: 'B' }, { x: 450, n: 'C' }];
---
<svg class="fig" viewBox="0 0 680 280" role="img" aria-labelledby="iv-title iv-desc">
  <title id="iv-title">A three-phase inverter</title>
  <desc id="iv-desc">A DC bus with a capacitor feeds three half-bridge legs. Each leg has a high-side and a low-side switch, and its midpoint connects to one motor phase. Switching the six transistors with pulse-width modulation sets the average voltage on each phase.</desc>
  <path class="wire" d="M70 50 H500 M70 230 H500" />
  <text x="70" y="40" class="t-small t-strong">DC bus +</text><text x="70" y="250" class="t-small t-strong">DC bus −</text>
  <!-- battery -->
  <path class="wire" d="M70 50 V124 M70 156 V230 M52 124 H88 M60 134 H80 M52 146 H88 M60 156 H80" />
  <text x="44" y="144" text-anchor="end" class="t-small">battery</text>
  <!-- cap -->
  <path class="wire" d="M150 50 V132 M150 148 V230 M132 132 H168 M132 148 H168" />
  <text x="176" y="144" class="t-small">bus</text><text x="176" y="159" class="t-small">capacitor</text>
  {legs.map((l, i) => (
    <g>
      <path class="wire" d={`M${l.x} 50 V74 M${l.x} 118 V162 M${l.x} 206 V230`} />
      <rect class="soft1 c1" stroke-width="1.4" x={l.x - 20} y="74" width="40" height="44" rx="6" />
      <rect class="soft1 c1" stroke-width="1.4" x={l.x - 20} y="162" width="40" height="44" rx="6" />
      <text x={l.x} y="101" text-anchor="middle" class="t-small">S{2 * i + 1}</text>
      <text x={l.x} y="189" text-anchor="middle" class="t-small">S{2 * i + 2}</text>
      <circle class="ink-fill" cx={l.x} cy="140" r="3.5" />
      <path class="c3" fill="none" stroke-width="1.8" d={`M${l.x} 140 H${l.x + 22} V${122 + i * 18} H560`} />
      <text x="552" y={117 + i * 18} text-anchor="end" class="t-small t-c3">{l.n}</text>
    </g>
  ))}
  <circle class="soft3 c3" stroke-width="1.6" cx="606" cy="140" r="46" />
  <text x="606" y="136" text-anchor="middle" class="t-strong">Motor</text><text x="606" y="153" text-anchor="middle" class="t-small t-muted">3 phases</text>
  <text x="350" y="272" text-anchor="middle" class="t-small t-muted">Each leg's two switches are never on together. Their duty cycle sets the average phase voltage.</text>
</svg>
