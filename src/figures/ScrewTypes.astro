---
// Cross-sections of a ball screw and a planetary roller screw. Schematic.
const ring = (cx: number, cy: number, r: number, n: number) =>
  Array.from({ length: n }, (_, i) => {
    const a = (i * 2 * Math.PI) / n - Math.PI / 2;
    return [cx + r * Math.cos(a), cy + r * Math.sin(a)];
  });
const balls = ring(170, 132, 62, 14);
const rollers = ring(510, 132, 58, 8);
---
<svg class="fig" viewBox="0 0 680 290" role="img" aria-labelledby="st-title st-desc">
  <title id="st-title">Ball screw and planetary roller screw in cross-section</title>
  <desc id="st-desc">In a ball screw, small balls roll between the screw and the nut, touching each at a point. In a planetary roller screw, larger threaded rollers sit between screw and nut and touch both along many thread flanks.</desc>

  <text x="170" y="22" text-anchor="middle" class="t-strong">Ball screw</text>
  <circle class="box" cx="170" cy="132" r="96" /><circle class="surface" cx="170" cy="132" r="74" />
  <circle class="none axis" cx="170" cy="132" r="74" />
  <circle class="soft1 c1" stroke-width="1.6" cx="170" cy="132" r="50" />
  {balls.map(([x, y]) => <circle class="f3" cx={x} cy={y} r="10.5" />)}
  <text x="170" y="136" text-anchor="middle" class="t-small t-strong">screw</text>
  <text x="170" y="50" text-anchor="middle" class="t-small">nut</text>
  <text x="170" y="252" text-anchor="middle" class="t-small t-c3">balls — point contacts</text>
  <text x="170" y="270" text-anchor="middle" class="t-small t-muted">low friction, moderate load</text>

  <text x="510" y="22" text-anchor="middle" class="t-strong">Planetary roller screw</text>
  <circle class="box" cx="510" cy="132" r="96" /><circle class="surface" cx="510" cy="132" r="80" />
  <circle class="none axis" cx="510" cy="132" r="80" />
  <circle class="soft1 c1" stroke-width="1.6" cx="510" cy="132" r="36" />
  {rollers.map(([x, y]) => <g><circle class="f3" cx={x} cy={y} r="21" /><circle class="none surface-stroke" cx={x} cy={y} r="15" /><circle class="none surface-stroke" cx={x} cy={y} r="9" /></g>)}
  <text x="510" y="136" text-anchor="middle" class="t-small t-strong">screw</text>
  <text x="510" y="48" text-anchor="middle" class="t-small">nut</text>
  <text x="510" y="252" text-anchor="middle" class="t-small t-c3">threaded rollers — line contacts on many threads</text>
  <text x="510" y="270" text-anchor="middle" class="t-small t-muted">higher load and shock capacity, higher cost</text>
</svg>
