<svg class="fig" viewBox="0 0 640 340" role="img" aria-labelledby="gr-title gr-desc" xmlns:c2pa="http://c2pa.org/manifest"><metadata><c2pa:manifest></c2pa:manifest></metadata>
  <title id="gr-title">Torque and reflected inertia against gear ratio</title>
  <desc id="gr-desc">On log-log axes, output torque rises in proportion to gear ratio N while reflected rotor inertia rises with N squared. Direct drive sits at N equals 1, quasi-direct drive around 3 to 10, and conventional high-ratio gearing around 30 to 160.</desc>
  <!-- bands -->
  <rect class="soft2" x="80" y="40" width="22" height="230" />
  <rect class="soft1" x="190" y="40" width="120" height="230" />
  <rect class="soft3" x="420" y="40" width="167" height="230" />
  <text x="84" y="30" class="t-small t-strong">Direct drive</text>
  <text x="250" y="30" text-anchor="middle" class="t-small t-strong">Quasi-direct drive</text>
  <text x="503" y="30" text-anchor="middle" class="t-small t-strong">High-ratio geared</text>
  <!-- grid -->
  <line class="grid" x1="80" y1="215" x2="600" y2="215" /><line class="grid" x1="80" y1="160" x2="600" y2="160" /><line class="grid" x1="80" y1="105" x2="600" y2="105" /><line class="grid" x1="80" y1="50" x2="600" y2="50" />
  <polyline class="axis" points="80,36 80,270 606,270" />
  <!-- curves -->
  <line class="c1" stroke-width="2.4" x1="80" y1="270" x2="587" y2="148.8" />
  <line class="c3" stroke-width="2.4" x1="80" y1="270" x2="540" y2="50" />
  <text x="560" y="140" text-anchor="end" class="t-strong">Output torque ∝ N</text>
  <text x="470" y="72" text-anchor="end" class="t-strong">Reflected inertia ∝ N²</text>
  <!-- ticks -->
  <text x="80" y="288" text-anchor="middle" class="t-small t-muted">1</text>
  <text x="310" y="288" text-anchor="middle" class="t-small t-muted">10</text>
  <text x="540" y="288" text-anchor="middle" class="t-small t-muted">100</text>
  <text x="72" y="274" text-anchor="end" class="t-small t-muted">1×</text>
  <text x="72" y="219" text-anchor="end" class="t-small t-muted">10×</text>
  <text x="72" y="164" text-anchor="end" class="t-small t-muted">100×</text>
  <text x="72" y="109" text-anchor="end" class="t-small t-muted">1,000×</text>
  <text x="72" y="54" text-anchor="end" class="t-small t-muted">10,000×</text>
  <text x="340" y="318" text-anchor="middle" class="t-muted">Gear ratio N (log scale)</text>
  <text x="18" y="155" transform="rotate(-90 18 155)" text-anchor="middle" class="t-muted">Relative to the bare motor (log scale)</text>
</svg>
