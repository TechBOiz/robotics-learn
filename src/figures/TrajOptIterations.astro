---
// Trajectory optimisation: an initial straight-line guess is deformed until it clears an obstacle.
const A = [70, 170], B = [630, 110], ob = { x: 350, y: 130, r: 56 };
const curve = (push: number) => Array.from({ length: 41 }, (_, i) => i / 40).map((s) => { const x = A[0] + s * (B[0] - A[0]), y = A[1] + s * (B[1] - A[1]) - push * Math.exp(-(((s - 0.5) / 0.2) ** 2)); return `${x.toFixed(1)},${y.toFixed(1)}`; }).join(' ');
const its = [0, 34, 68, 96];
---
<svg class="fig" viewBox="0 0 700 270" role="img" aria-labelledby="ti-title ti-desc">
  <title id="ti-title">Trajectory optimisation deforming a path around an obstacle</title>
  <desc id="ti-desc">A straight line from start to goal passes through a round obstacle. Over successive iterations of the optimiser the path bends upward, further each time, until it clears the obstacle with a margin while staying smooth and as short as possible.</desc>
  <circle class="ink-fill" opacity="0.28" cx={ob.x} cy={ob.y} r={ob.r} /><circle class="none wire-muted dash" cx={ob.x} cy={ob.y} r={ob.r + 14} />
  <text x={ob.x} y={ob.y + 24} text-anchor="middle" class="t-small">obstacle</text>
  {its.map((p, i) => <polyline class={i === its.length - 1 ? 'c2' : i === 0 ? 'c3' : 'wire-muted'} fill="none" stroke-width={i === its.length - 1 ? 3.2 : 1.8} stroke-dasharray={i === 0 || i === its.length - 1 ? '' : '5 4'} points={curve(p)} />)}
  <circle class="f1" cx={A[0]} cy={A[1]} r="7" /><circle class="f1" cx={B[0]} cy={B[1]} r="7" />
  <text x={A[0]} y={A[1] + 24} text-anchor="middle" class="t-small t-strong">start</text><text x={B[0]} y={B[1] + 24} text-anchor="middle" class="t-small t-strong">goal</text>
  <text x="140" y="184" class="t-small t-c3">initial guess: straight through</text>
  <text x="350" y="24" text-anchor="middle" class="t-small t-strong t-c2">optimised: smooth, short, and clear of the obstacle</text>
  <text x="560" y="74" class="t-small t-muted">dashed circle:</text><text x="560" y="89" class="t-small t-muted">safety margin</text>
  <text x="350" y="232" text-anchor="middle" class="t-small">Each iteration nudges every point of the path downhill on a cost that mixes smoothness and obstacle distance.</text>
  <text x="350" y="252" text-anchor="middle" class="t-small t-muted">It finds the nearest good path, not necessarily the best one: start on the wrong side and it stays there.</text>
</svg>
