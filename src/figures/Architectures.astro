---
// Static figure: four ways to connect a motor to a link.
---
<svg class="fig" viewBox="0 0 720 372" role="img" aria-labelledby="ar-title ar-desc">
  <title id="ar-title">Four actuator architectures compared as block chains</title>
  <desc id="ar-desc">High-ratio geared: small motor, large reducer, torque sensor, link. Direct drive: large motor straight to the link. Quasi-direct drive: large motor, small single-stage reducer, link. Series elastic: small motor, reducer, spring, link.</desc>

  <text x="14" y="50" class="t-strong">High-ratio geared</text>
  <text x="14" y="67" class="t-small t-muted">small motor, big reduction</text>
  <rect class="soft1" x="200" y="32" width="56" height="40" rx="6" /><text x="228" y="57" text-anchor="middle" class="t-small">motor</text>
  <rect class="soft3" x="262" y="20" width="150" height="64" rx="6" /><text x="337" y="49" text-anchor="middle" class="t-small">reducer</text><text x="337" y="65" text-anchor="middle" class="t-small t-strong">50–160 : 1</text>
  <rect class="soft2" x="418" y="28" width="46" height="48" rx="6" /><text x="441" y="49" text-anchor="middle" class="t-small">torque</text><text x="441" y="63" text-anchor="middle" class="t-small">sensor</text>
  <rect class="box" x="470" y="40" width="236" height="24" rx="12" /><text x="588" y="57" text-anchor="middle" class="t-small">link</text>

  <line class="grid" x1="14" y1="98" x2="706" y2="98" />
  <text x="14" y="144" class="t-strong">Direct drive</text>
  <text x="14" y="161" class="t-small t-muted">no reducer at all</text>
  <rect class="soft1" x="200" y="108" width="150" height="76" rx="6" /><text x="275" y="143" text-anchor="middle" class="t-small">large-diameter</text><text x="275" y="159" text-anchor="middle" class="t-small">motor</text>
  <rect class="box" x="356" y="134" width="350" height="24" rx="12" /><text x="531" y="151" text-anchor="middle" class="t-small">link</text>

  <line class="grid" x1="14" y1="194" x2="706" y2="194" />
  <text x="14" y="238" class="t-strong">Quasi-direct drive</text>
  <text x="14" y="255" class="t-small t-muted">big motor, one low-ratio stage</text>
  <rect class="soft1" x="200" y="206" width="120" height="68" rx="6" /><text x="260" y="237" text-anchor="middle" class="t-small">high-torque</text><text x="260" y="253" text-anchor="middle" class="t-small">motor</text>
  <rect class="soft3" x="326" y="216" width="64" height="48" rx="6" /><text x="358" y="237" text-anchor="middle" class="t-small">planetary</text><text x="358" y="253" text-anchor="middle" class="t-small t-strong">5–10 : 1</text>
  <rect class="box" x="396" y="228" width="310" height="24" rx="12" /><text x="551" y="245" text-anchor="middle" class="t-small">link</text>

  <line class="grid" x1="14" y1="286" x2="706" y2="286" />
  <text x="14" y="326" class="t-strong">Series elastic</text>
  <text x="14" y="343" class="t-small t-muted">a spring between gear and load</text>
  <rect class="soft1" x="200" y="306" width="56" height="40" rx="6" /><text x="228" y="331" text-anchor="middle" class="t-small">motor</text>
  <rect class="soft3" x="262" y="298" width="110" height="56" rx="6" /><text x="317" y="331" text-anchor="middle" class="t-small">reducer</text>
  <polyline class="c2 thick" points="372,326 384,326 390,312 402,340 414,312 426,340 438,312 450,340 456,326 468,326" />
  <text x="420" y="366" text-anchor="middle" class="t-small t-c2">spring — deflection measures force</text>
  <rect class="box" x="468" y="314" width="238" height="24" rx="12" /><text x="587" y="331" text-anchor="middle" class="t-small">link</text>
</svg>
