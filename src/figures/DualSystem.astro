---
// Dual-system VLA: a slow reasoning model and a fast action model.
import ArrowDef from '../components/ArrowDef.astro';
const slow = [0, 1, 2].map((i) => 70 + i * 205);
const fast = Array.from({ length: 41 }, (_, i) => 70 + i * 15);
---
<svg class="fig" viewBox="0 0 720 240" role="img" aria-labelledby="ds-title ds-desc">
  <title id="ds-title">A dual-system vision-language-action model</title>
  <desc id="ds-desc">Two networks run at different rates. A large vision-language model runs a few times per second and produces a compact summary of the scene and the goal. A small, fast network reads the latest summary together with fresh sensor data and outputs motor commands hundreds of times per second.</desc>
  <defs><ArrowDef id="ah-ds" /></defs>
  <text x="14" y="34" class="t-strong t-c4">System 2 — slow, large</text><text x="14" y="52" class="t-small">understands the scene and the instruction</text>
  {slow.map((x) => <g><rect class="soft4 c4" stroke-width="1.4" x={x} y="68" width="150" height="36" rx="6" /><text x={x + 75} y="91" text-anchor="middle" class="t-small">one slow pass</text><line class="wire" x1={x + 150} y1="104" x2={x + 150} y2="158" marker-end="url(#ah-ds)" /></g>)}
  <text x="190" y="34" class="t-small t-muted">· a few Hz</text>
  <text x="14" y="146" class="t-strong t-c3">System 1 — fast, small</text>
  <line class="axis" x1="70" y1="176" x2="690" y2="176" />
  {fast.map((x) => <rect class="f3" x={x} y="162" width="9" height="28" rx="2" />)}
  <text x="184" y="146" class="t-small t-muted">· hundreds of Hz</text>
  <text x="380" y="214" text-anchor="middle" class="t-small">Each fast step uses the most recent slow output plus fresh camera and joint readings.</text>
  <text x="380" y="232" text-anchor="middle" class="t-small t-muted">The arm keeps reacting smoothly while the large model is still thinking.</text>
</svg>
