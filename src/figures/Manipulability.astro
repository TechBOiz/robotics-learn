---
// Velocity ellipses of a two-link arm in a well-conditioned and a near-singular pose.
const l1 = 110, l2 = 100;
function pose(ox: number, oy: number, d1: number, d2: number) {
  const t1 = (d1 * Math.PI) / 180, t2 = (d2 * Math.PI) / 180, s1 = Math.sin(t1), c1 = Math.cos(t1), s12 = Math.sin(t1 + t2), c12 = Math.cos(t1 + t2);
  const e = [l1 * c1, l1 * s1], tip = [e[0] + l2 * c12, e[1] + l2 * s12];
  const J = [[-l1 * s1 - l2 * s12, -l2 * s12], [l1 * c1 + l2 * c12, l2 * c12]];
  const A = J[0][0] ** 2 + J[0][1] ** 2, B = J[0][0] * J[1][0] + J[0][1] * J[1][1], D = J[1][0] ** 2 + J[1][1] ** 2;
  const tr = A + D, det = A * D - B * B, s = Math.sqrt(Math.max(0, (tr * tr) / 4 - det));
  const lam1 = tr / 2 + s, lam2 = Math.max(0, tr / 2 - s);
  const ang = Math.atan2(lam1 - A, B); // major axis direction in math coords
  const k = 0.3;
  return { o: [ox, oy], e: [ox + e[0], oy - e[1]], tip: [ox + tip[0], oy - tip[1]], rx: k * Math.sqrt(lam1), ry: Math.max(2, k * Math.sqrt(lam2)), rot: (-ang * 180) / Math.PI };
}
const good = pose(70, 250, 75, -95), bad = pose(400, 250, 40, -8);
---
<svg class="fig" viewBox="0 0 700 300" role="img" aria-labelledby="mp-title mp-desc">
  <title id="mp-title">Tip-velocity ellipses in a bent pose and a nearly straight pose</title>
  <desc id="mp-desc">Left: with the elbow bent near ninety degrees, the tip can move at similar speed in every direction, shown by a round ellipse. Right: with the arm almost straight, the ellipse collapses to a thin sliver. The tip can still move sideways but hardly at all along the arm: the pose is near a singularity.</desc>
  {[good, bad].map((p) => (
    <g>
      <ellipse class="soft2 c2" stroke-width="1.6" cx={p.tip[0]} cy={p.tip[1]} rx={p.rx} ry={p.ry} transform={`rotate(${p.rot} ${p.tip[0]} ${p.tip[1]})`} />
      <polyline class="c1" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" fill="none" points={`${p.o[0]},${p.o[1]} ${p.e[0]},${p.e[1]} ${p.tip[0]},${p.tip[1]}`} />
      <circle class="surface c1" stroke-width="2.5" cx={p.o[0]} cy={p.o[1]} r="7" /><circle class="surface c1" stroke-width="2.5" cx={p.e[0]} cy={p.e[1]} r="7" />
      <circle class="f3" cx={p.tip[0]} cy={p.tip[1]} r="5" />
      <line class="axis" x1={p.o[0] - 30} y1={p.o[1]} x2={p.o[0] + 240} y2={p.o[1]} />
    </g>
  ))}
  <text x="170" y="282" text-anchor="middle" class="t-strong">Elbow bent</text><text x="170" y="298" text-anchor="middle" class="t-small t-muted">moves well in all directions</text>
  <text x="520" y="282" text-anchor="middle" class="t-strong">Nearly straight</text><text x="520" y="298" text-anchor="middle" class="t-small t-muted">almost no motion along the arm</text>
  <text x="350" y="20" text-anchor="middle" class="t-small t-c2">green: tip velocities reachable with unit joint speed</text>
</svg>
