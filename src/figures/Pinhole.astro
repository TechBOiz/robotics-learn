---
// Pinhole camera model.
import ArrowDef from '../components/ArrowDef.astro';
---
<svg class="fig" viewBox="0 0 700 300" role="img" aria-labelledby="ph-title ph-desc">
  <title id="ph-title">The pinhole camera model</title>
  <desc id="ph-desc">A ray from a point in the scene passes through the camera's optical centre and lands on the image plane, which sits one focal length in front of the centre. By similar triangles, the image coordinate equals the focal length times the point's sideways offset divided by its depth.</desc>
  <defs><ArrowDef id="ah-ph" /></defs>
  <line class="wire-muted" stroke-dasharray="12 4 2 4" x1="60" y1="170" x2="660" y2="170" marker-end="url(#ah-ph)" /><text x="664" y="188" text-anchor="end" class="t-small t-muted">optical axis (Z)</text>
  <circle class="f1" cx="110" cy="170" r="7" /><text x="110" y="200" text-anchor="middle" class="t-small t-strong t-c1">optical centre</text>
  <line class="c3" stroke-width="4" x1="250" y1="60" x2="250" y2="270" /><text x="250" y="48" text-anchor="middle" class="t-small t-strong t-c3">image plane</text>
  <circle class="ink-fill" cx="580" cy="62" r="7" /><text x="592" y="58" class="t-strong">P (X, Y, Z)</text><text x="592" y="75" class="t-small t-muted">point in the scene</text>
  <line class="c2" stroke-width="1.8" x1="110" y1="170" x2="580" y2="62" />
  <circle class="surface c3" stroke-width="2.5" cx="250" cy="137.8" r="6" /><text x="262" y="126" class="t-small t-strong t-c3">p (u, v)</text>
  <line class="wire-muted dash" x1="580" y1="62" x2="580" y2="170" /><text x="590" y="122" class="t-small t-math">X</text>
  <line class="wire-muted" x1="110" y1="232" x2="250" y2="232" marker-start="url(#ah-ph)" marker-end="url(#ah-ph)" /><text x="180" y="250" text-anchor="middle" class="t-small t-math">f — focal length</text>
  <line class="wire-muted" x1="110" y1="276" x2="580" y2="276" marker-start="url(#ah-ph)" marker-end="url(#ah-ph)" /><text x="345" y="294" text-anchor="middle" class="t-small t-math">Z — depth</text>
  <text x="330" y="212" class="t-strong">u = f · X / Z  (+ image centre)</text>
  <text x="330" y="24" class="t-small t-muted">Every point on the green ray lands on the same pixel: depth is lost.</text>
</svg>
