---
// A small SLAM factor graph.
const poses = [0, 1, 2, 3, 4].map((i) => ({ x: 90 + i * 130, y: 150 }));
const lms = [{ x: 220, y: 44, sees: [0, 1, 2] }, { x: 480, y: 44, sees: [2, 3, 4] }];
---
<svg class="fig" viewBox="0 0 700 280" role="img" aria-labelledby="fg-title fg-desc">
  <title id="fg-title">A factor graph for SLAM</title>
  <desc id="fg-desc">Circles are unknowns: five robot poses in a row and two landmarks above them. Small squares are factors, each a measurement that ties unknowns together. Odometry factors link consecutive poses. Observation factors link a pose to a landmark it saw. A loop-closure factor links the last pose back to the first. A prior factor anchors the first pose.</desc>
  {lms.map((l) => l.sees.map((i) => { const p = poses[i]; const mx = (l.x + p.x) / 2, my = (l.y + p.y) / 2; return <g><line class="wire-muted" x1={l.x} y1={l.y} x2={p.x} y2={p.y} /><rect class="f3" x={mx - 5} y={my - 5} width="10" height="10" /></g>; }))}
  {poses.slice(0, 4).map((p, i) => <g><line class="wire" x1={p.x} y1={p.y} x2={poses[i + 1].x} y2={p.y} /><rect class="f1" x={p.x + 60} y={p.y - 5} width="10" height="10" /></g>)}
  <path class="c2" fill="none" stroke-width="1.8" stroke-dasharray="6 4" d={`M${poses[4].x} ${poses[4].y} Q350 280 ${poses[0].x} ${poses[0].y}`} /><rect class="f2" x="345" y="210" width="10" height="10" />
  <line class="wire" x1="40" y1="150" x2="90" y2="150" /><rect class="ink-fill" x="35" y="145" width="10" height="10" />
  {poses.map((p, i) => <g><circle class="surface c1" stroke-width="2.5" cx={p.x} cy={p.y} r="20" /><text x={p.x} y={p.y + 5} text-anchor="middle" class="t-strong">x{i + 1}</text></g>)}
  {lms.map((l, i) => <g><circle class="surface c3" stroke-width="2.5" cx={l.x} cy={l.y} r="20" /><text x={l.x} y={l.y + 5} text-anchor="middle" class="t-strong">l{i + 1}</text></g>)}
    <text x="350" y="14" text-anchor="middle" class="t-small"><tspan class="t-c3">l: landmarks</tspan> — where things are   ·   <tspan class="t-c1">x: poses</tspan> — where the robot was</text>
  <text x="350" y="248" text-anchor="middle" class="t-small t-c2">loop closure: x5 is the same place as x1</text>
  <text x="35" y="130" text-anchor="middle" class="t-small t-muted">prior</text>
  <text x="350" y="272" text-anchor="middle" class="t-small t-muted">Squares are measurements. Solving the graph means finding the poses and landmarks that best satisfy all of them at once.</text>
</svg>
