---
import 'katex/dist/katex.min.css';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { categories, getCategory } from '../../data/categories';
import { getArticles, type Article } from '../../lib/articles';
import { levelLabel } from '../../lib/outline';
import { articleHref, formatDate, href, readingMinutes, splitId } from '../../lib/paths';

export async function getStaticPaths() {
  const all = await getArticles();
  // Whole-curriculum order: topics in learning order, then articles within each topic.
  const ordered = categories.flatMap((c) => all.filter((a) => a.data.category === c.id));
  return ordered.map((article, k) => {
    const siblings = ordered.filter((a) => a.data.category === article.data.category);
    const i = siblings.findIndex((a) => a.id === article.id);
    return { params: splitId(article.id), props: { article, prev: ordered[k - 1], next: ordered[k + 1], position: i + 1, total: siblings.length } };
  });
}

interface Props { article: Article; prev?: Article; next?: Article; position: number; total: number }

const { article, prev, next, position, total } = Astro.props;
const { Content, headings } = await render(article);
const category = getCategory(article.data.category);
const toc = headings.filter((h) => h.depth === 2);
const label = (other: Article, word: string) => (other.data.category === article.data.category ? word : `${word} topic: ${getCategory(other.data.category).name}`);
---
<Base title={article.data.title} description={article.data.summary} currentTopic={category.id} currentArticle={article.id}>
  <article>
    <header class="article-head">
      <ol class="crumbs"><li><a href={href('/')}>All topics</a></li><li><a href={href(`/${category.id}/`)}>{category.name}</a></li><li>Part {position} of {total}</li></ol>
      <h1 class="page-title">{article.data.title}</h1>
      <p class="lede">{article.data.summary}</p>
      <div class="meta">
        <span class:list={['level', article.data.level]}>{levelLabel[article.data.level]}</span>
        <span>{readingMinutes(article.body)} min read</span>
        <span>Updated <time datetime={article.data.updated.toISOString().slice(0, 10)}>{formatDate(article.data.updated)}</time></span>
      </div>
    </header>

    <div class="article-grid">
      <div>
        <div class="prose"><Content /></div>
        <div class="finish">
          <div class="finish-actions">
            <button class="btn quiet" type="button" data-mark-read={article.id} aria-pressed="false">Mark as read</button>
            {next && <a class="btn" href={articleHref(next.id)} data-mark-on-click={article.id}>Mark as read and continue</a>}
          </div>
          <nav class="pager" aria-label="In this topic">
            {prev && <a class="prev" href={articleHref(prev.id)}><small>{label(prev, 'Previous')}</small><strong>{prev.data.title}</strong></a>}
            {next && <a class="next" href={articleHref(next.id)}><small>{label(next, 'Next')}</small><strong>{next.data.title}</strong></a>}
          </nav>
        </div>
      </div>
      {toc.length > 1 && (
        <nav class="toc" aria-label="On this page">
          <h2>On this page</h2>
          <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </nav>
      )}
    </div>
  </article>
</Base>
