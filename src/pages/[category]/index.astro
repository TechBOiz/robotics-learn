---
import Base from '../../layouts/Base.astro';
import ArticleRows from '../../components/ArticleRows.astro';
import { categories } from '../../data/categories';
import { getOutline } from '../../lib/outline';
import { href } from '../../lib/paths';

export function getStaticPaths() {
  return categories.map((category) => ({ params: { category: category.id }, props: { category } }));
}

const { category } = Astro.props;
const topic = (await getOutline()).find((t) => t.id === category.id);
const minutes = topic ? topic.articles.reduce((n, a) => n + a.minutes, 0) : 0;
---
<Base title={category.name} description={category.blurb} currentTopic={category.id}>
  <ol class="crumbs"><li><a href={href('/')}>All topics</a></li><li>{category.name}</li></ol>
  <h1 class="page-title">{category.name}</h1>
  <p class="lede">{category.blurb}</p>
  {topic ? (
    <>
      <p class="meta" style="margin-top:1rem">
        <span>{topic.articles.length} {topic.articles.length === 1 ? 'article' : 'articles'}</span>
        <span>about {minutes} minutes of reading</span>
        <span><span data-progress-for={category.id}>0/{topic.articles.length}</span> read</span>
      </p>
      <section class="topic" aria-label="Articles" style="margin-top:1.4rem">
        <ArticleRows articles={topic.articles} />
      </section>
    </>
  ) : (
    <p class="lede">Nothing is published in this topic yet. <a href={href('/')}>Browse all topics</a>.</p>
  )}
</Base>
